---
const consoleUrl = "https://console.rumptycloud.com";
const discordUrl = "https://discord.gg/Rukmqzg3uX";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="RumptyCloud Blog home">
      <img src="/favicon.png" width="32" height="32" alt="" />
      <span>Rumpty<span class="brand-cloud">Cloud</span> Blog</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/#latest">Latest</a>
      <a href="/">Guides</a>
      <a href="https://docs.rumptycloud.com">Docs</a>
      <a href={discordUrl}>Discord</a>
      <a href="/rss.xml">RSS</a>
      <a class="button-link" href={consoleUrl}>Open console</a>
    </nav>
  </div>
</header>
