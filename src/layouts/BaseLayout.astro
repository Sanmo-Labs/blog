---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import Search from "../components/Search.astro";
import { getCollection } from "astro:content";
import { noteInfo } from "../lib/notes";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  author?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedDate?: Date;
  updatedDate?: Date;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/journal/img/hero-1080.jpg",
  imageAlt = "The RumptyCloud Journal illustration",
  imageWidth,
  imageHeight,
  author,
  noindex = false,
  type = "website",
  publishedDate,
  updatedDate,
  structuredData,
} = Astro.props;

const notes = (await getCollection("posts", ({ data }) => !data.draft)).map(noteInfo);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const fullTitle = title === "RumptyCloud Blog" ? title : `${title} | RumptyCloud Blog`;
const imageType = ({ webp: "image/webp", png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg" } as Record<string, string>)[socialImageURL.pathname.split(".").pop() ?? ""];
const width = imageWidth ?? (image === "/journal/img/hero-1080.jpg" ? 1080 : undefined);
const height = imageHeight ?? (image === "/journal/img/hero-1080.jpg" ? 1080 : undefined);
const homeURL = new URL("/", Astro.site ?? Astro.url).href;
const organizationID = `${homeURL}#organization`;
const websiteID = `${homeURL}#website`;
const pageID = `${canonicalURL.href}#webpage`;
const imageID = `${canonicalURL.href}#primaryimage`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": organizationID, name: "RumptyCloud", url: "https://rumptycloud.com", logo: { "@type": "ImageObject", url: new URL("/favicon.png", homeURL).href }, sameAs: ["https://www.youtube.com/channel/UCp7tjsn-Fb7oAUngUIdGq5Q"] },
    { "@type": "WebSite", "@id": websiteID, url: homeURL, name: "RumptyCloud Blog", alternateName: "The Journal", inLanguage: "en", publisher: { "@id": organizationID } },
    { "@type": "ImageObject", "@id": imageID, url: socialImageURL.href, contentUrl: socialImageURL.href, caption: imageAlt, width, height, encodingFormat: imageType },
    { "@type": Astro.url.pathname === "/" ? "CollectionPage" : "WebPage", "@id": pageID, url: canonicalURL.href, name: title, description, inLanguage: "en", isPartOf: { "@id": websiteID }, primaryImageOfPage: { "@id": imageID }, ...(type === "article" ? { mainEntity: { "@id": `${canonicalURL.href}#article` }, breadcrumb: { "@id": `${canonicalURL.href}#breadcrumb` } } : {}) },
    ...(structuredData ?? []),
  ],
};

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0f14" />
    <script is:inline>
      (() => {
        const key = 'rumpty-theme';
        const system = matchMedia('(prefers-color-scheme: light)');
        let choice;
        try { choice = localStorage.getItem(key); } catch { /* Storage may be unavailable. */ }
        const valid = value => value === 'light' || value === 'dark';
        const apply = () => {
          const theme = valid(choice) ? choice : system.matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').content = theme === 'light' ? '#f8f5ed' : '#0c0f14';
          const button = document.querySelector('.theme-toggle');
          if (button) {
            button.hidden = false;
            button.setAttribute('aria-pressed', String(theme === 'light'));
            button.title = `Switch to ${theme === 'light' ? 'dark' : 'light'} mode`;
          }
        };
        apply();
        document.addEventListener('DOMContentLoaded', apply, { once: true });
        document.addEventListener('click', event => {
          if (!event.target.closest('.theme-toggle')) return;
          choice = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          try { localStorage.setItem(key, choice); } catch { /* Still switch for this page. */ }
          apply();
        });
        system.addEventListener('change', () => { if (!valid(choice)) apply(); });
        window.addEventListener('storage', event => {
          if (event.key === key || event.key === null) { choice = event.newValue; apply(); }
        });
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {author && <meta name="author" content={author} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png?v=5" />
    <link rel="apple-touch-icon" href="/favicon.png?v=5" />
    <link rel="alternate" type="application/rss+xml" title="RumptyCloud Blog" href="/rss.xml" />
    <link rel="preload" href="/journal/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/journal/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/journal/css/base.css" />
    <link rel="stylesheet" href="/journal/css/journal.css" />
    {type === "article" && <link rel="stylesheet" href="/journal/css/note.css" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="RumptyCloud Blog" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    {width && <meta property="og:image:width" content={String(width)} />}
    {height && <meta property="og:image:height" content={String(height)} />}
    {imageType && <meta property="og:image:type" content={imageType} />}
    <meta property="og:locale" content="en_NG" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{fullTitle}</title>
    {
      !noindex && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Search />
    <span class="sr-only" role="status" id="status"></span>
    <script is:inline type="application/json" id="notes-index" set:html={JSON.stringify(notes).replace(/</g, "\\u003c")} />
    <script is:inline src="/journal/js/site.js" defer></script>
    <script is:inline src="/journal/js/motion.js" defer></script>
    {type !== "article" && <script is:inline src="/journal/js/filters.js" defer></script>}
  </body>
</html>
