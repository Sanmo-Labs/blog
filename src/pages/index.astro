---
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { noteInfo } from "../lib/notes";
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const notes = posts.map(noteInfo);
const structuredData = [{
  "@type": "ItemList",
  "@id": new URL("/#notes", Astro.site ?? Astro.url).href,
  name: "All notes",
  numberOfItems: posts.length,
  itemListElement: posts.map((post, index) => ({ "@type": "ListItem", position: index + 1, name: post.data.title, url: new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url).href })),
}];
const topics = [...new Map(notes.map(note => [note.cat, note.topic])).entries()];
---
<BaseLayout structuredData={structuredData} title="The Journal" description="Practical guides, product updates, and honest field notes for developers building and deploying on RumptyCloud." image="/journal/img/hero-1080.jpg">
<section class="wrap hero">
      <div class="hero__inner">
        <div class="hero__text">
          <p class="eyebrow eyebrow--orange">The RumptyCloud blog</p>
          <h1 class="hero__title">The<br>Journal<span class="dot">.</span></h1>
          <p class="hero__lede">Practical guides, product updates, and honest field notes for developers building and deploying on RumptyCloud.</p>
          <ul class="chips" aria-label="Journal stats">
            <li class="chip"><span data-stat="notes">{posts.length}</span> notes</li>
            <li class="chip"><span data-stat="minutes">{notes.reduce((sum, note) => sum + note.minutes, 0)}</span> min of reading</li>
          </ul>
        </div>
        <img class="hero__art"
             src="/journal/img/hero-1080.webp"
             srcset="/journal/img/hero-540.webp 540w, /journal/img/hero-1080.webp 1080w"
             sizes="(min-width: 960px) 540px, calc(100vw - 32px)"
             width="540" height="540" alt="" fetchpriority="high">
      </div>
    </section>
<section class="wrap filters" aria-labelledby="notes-heading">
  <h2 class="filters__title" id="notes-heading" tabindex="-1">All notes</h2>
  <span class="filters__count" id="notes-count" aria-live="polite">{String(posts.length).padStart(2, "0")}</span>
  <div class="seg" role="group" aria-label="Filter notes by topic">
    <button type="button" class="seg__opt is-active" data-filter="all" data-label="All notes" aria-pressed="true">All <span class="seg__n">{posts.length}</span></button>
    {topics.map(([cat, topic]) => <button type="button" class="seg__opt" data-filter={cat} data-label={topic} aria-pressed="false"><i class="dot-sm" data-cat={cat}></i>{topic} <span class="seg__n">{notes.filter(note => note.cat === cat).length}</span></button>)}
  </div>
</section>
<section class="wrap" aria-label="Notes">
  <div class="notes" id="notes" data-page-size="4">{posts.map((post, index) => <PostCard post={post} index={posts.length - index} latest={index === 0} />)}</div>
  {posts.length === 0 && <p>First note coming soon. Follow the RSS feed to catch it when it lands.</p>}
</section>
<nav class="wrap pager" id="pagination" aria-label="Notes pagination" hidden>
  <span class="pager__btn is-disabled" id="page-newer" aria-disabled="true"><span aria-hidden="true">←</span> Newer</span>
  <div class="pager__mid">
    <ol class="pager__pages" id="page-numbers"></ol>
    <span class="pager__label" id="page-label" aria-live="polite"></span>
  </div>
  <span class="pager__btn is-disabled" id="page-older" aria-disabled="true">Older <span aria-hidden="true">→</span></span>
</nav>
</BaseLayout>
